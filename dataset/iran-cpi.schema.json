{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planro.local/schemas/iran-cpi.schema.json",
  "title": "PlanroIranCPIReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "countryCode",
    "provider",
    "baseCurrency",
    "months",
    "updatedAt"
  ],
  "properties": {
    "countryCode": {
      "const": "IR"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^(?!.*&amp;)https://[^\\s\\[\\]]+$"
        }
      },
      "description": "فقط انتشار رسمی مرکز آمار ایران پذیرفته است؛ نام و URL باید به همان انتشار رسمی اشاره کنند."
    },
    "baseCurrency": {
      "const": "IRT"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "indexes",
          "sourceUrl",
          "publishedAt"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "indexes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "all_items",
              "food_and_beverages",
              "restaurants_and_hotels",
              "transport",
              "recreation_and_culture",
              "clothing_and_footwear",
              "health",
              "miscellaneous_goods"
            ],
            "properties": {
              "all_items": {
                "type": "number",
                "minimum": 0
              },
              "food_and_beverages": {
                "type": "number",
                "minimum": 0
              },
              "restaurants_and_hotels": {
                "type": "number",
                "minimum": 0
              },
              "transport": {
                "type": "number",
                "minimum": 0
              },
              "recreation_and_culture": {
                "type": "number",
                "minimum": 0
              },
              "clothing_and_footwear": {
                "type": "number",
                "minimum": 0
              },
              "health": {
                "type": "number",
                "minimum": 0
              },
              "miscellaneous_goods": {
                "type": "number",
                "minimum": 0
              }
            },
            "description": "شاخص رسمی ماهانه برای تمام دسته‌هایی که Place Schema اجازهٔ استفاده در inflationCategory می‌دهد."
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^(?!.*&amp;)https://[^\\s\\[\\]]+$"
          },
          "publishedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
