{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/place.schema.json",
  "title": "TourismPlace",
  "description": "اسکیمای واحد برای مکان‌های گردشگری. فیلدهای derived (search/quality/graph) فقط توسط pipeline نوشته می‌شوند.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "type",
    "status",
    "name",
    "location",
    "content",
    "visit",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "شناسهٔ یکتای پایدار پروژه؛ باید از الگوی ID تعریف‌شده در README.md پیروی کند."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "اسلاگ لاتین یکتا برای URL"
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "type": {
      "enum": [
        "natural",
        "historical",
        "religious",
        "museum",
        "village",
        "city",
        "park",
        "recreational",
        "market",
        "accommodation",
        "restaurant",
        "route",
        "other"
      ]
    },
    "subType": {
      "type": "string",
      "description": "مثل waterfall, cave, palace, bazaar, caravanserai …"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "name": {
      "type": "object",
      "required": [
        "fa"
      ],
      "additionalProperties": false,
      "properties": {
        "fa": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "country",
        "province",
        "coordinates",
        "address"
      ],
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "default": "Iran"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "province": {
          "type": "string"
        },
        "county": {
          "type": "string",
          "description": "شهرستان"
        },
        "district": {
          "type": "string",
          "description": "بخش"
        },
        "ruralDistrict": {
          "type": "string",
          "description": "دهستان"
        },
        "city": {
          "type": "string"
        },
        "village": {
          "type": "string"
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "full": {
              "type": "string",
              "minLength": 1
            },
            "postalCode": {
              "type": "string"
            }
          },
          "required": [
            "full"
          ]
        },
        "coordinates": {
          "type": "object",
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false,
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "elevationMeters": {
              "type": [
                "number",
                "null"
              ]
            },
            "plusCode": {
              "type": "string"
            },
            "geoJson": {
              "type": [
                "object",
                "null"
              ],
              "description": "برای محدوده‌های چندضلعی (پارک ملی، دریاچه…)"
            },
            "boundingbox": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Bounding box از Nominatim با ترتیب [lat_min, lat_max, lon_min, lon_max]؛ هر مقدار number یا numeric string است."
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/i18nText"
        },
        "description": {
          "$ref": "#/$defs/i18nText"
        },
        "history": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "culture": {
          "type": "string",
          "minLength": 1
        },
        "whyVisit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "heritage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nationalRegistration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registered": {
              "type": "boolean"
            },
            "registrationNumber": {
              "type": "string"
            },
            "year": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "unesco": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "inscribed",
                "tentative",
                "none"
              ]
            },
            "year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reference": {
              "type": "string",
              "description": "شماره پرونده یونسکو"
            }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "website": {
          "type": "string",
          "pattern": "^(?!.*&amp;)https://[^\\s\\[\\]]+$",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "instagram": {
          "type": "string",
          "pattern": "^(?!.*&amp;)https://[^\\s\\[\\]]+$",
          "minLength": 1
        }
      }
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMinutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "typical": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "bestTimeOfDay": {
          "type": "array",
          "items": {
            "enum": [
              "sunrise",
              "morning",
              "noon",
              "afternoon",
              "sunset",
              "night"
            ]
          },
          "uniqueItems": true
        },
        "bestSeasons": {
          "type": "array",
          "items": {
            "enum": [
              "spring",
              "summer",
              "autumn",
              "winter"
            ]
          },
          "uniqueItems": true
        },
        "bestMonths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true,
          "description": "تنها منبع حقیقت برای ماه‌های پیشنهادی — در climate تکرار نمی‌شود"
        },
        "openingHours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alwaysOpen": {
              "type": "boolean"
            },
            "regular": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "days",
                  "open",
                  "close"
                ],
                "additionalProperties": false,
                "properties": {
                  "days": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "sat",
                        "sun",
                        "mon",
                        "tue",
                        "wed",
                        "thu",
                        "fri"
                      ]
                    },
                    "minItems": 1
                  },
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                }
              }
            },
            "exceptions": {
              "type": "array",
              "description": "تعطیلات رسمی، رمضان، نوروز…",
              "items": {
                "type": "object",
                "required": [
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "closed": {
                    "type": "boolean"
                  },
                  "open": {
                    "type": "string"
                  },
                  "close": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "entryFee": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isFree": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "domestic": {
              "type": [
                "number",
                "null"
              ],
              "description": "قیمت اتباع داخلی به واحد currency"
            },
            "foreign": {
              "type": [
                "number",
                "null"
              ],
              "description": "قیمت اتباع خارجی"
            },
            "currency": {
              "enum": [
                "IRR",
                "IRT"
              ],
              "description": "صریح: ریال یا تومان"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "difficulty": {
          "enum": [
            "easy",
            "moderate",
            "hard",
            "extreme",
            null
          ]
        },
        "requiresReservation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "requiresGuide": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "crowdLevel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "typical": {
              "enum": [
                "low",
                "medium",
                "high",
                null
              ]
            },
            "peak": {
              "type": "string",
              "description": "مثلاً «تعطیلات نوروز و آخر هفته‌ها»"
            }
          }
        }
      },
      "minProperties": 1
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "description": "به‌جای بولین‌های بسته. نبودن آیتم = نامشخص؛ منفی صریح با پیشوند not_",
      "items": {
        "enum": [
          "family_friendly",
          "kids_friendly",
          "elderly_friendly",
          "wheelchair_accessible",
          "not_wheelchair_accessible",
          "pet_friendly",
          "not_pet_friendly",
          "photography",
          "photography_restricted",
          "camping",
          "hiking",
          "cycling",
          "swimming",
          "romantic",
          "adventure",
          "eco_tourism",
          "religious_site",
          "sunrise_spot",
          "sunset_spot",
          "stargazing"
        ]
      }
    },
    "facilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "parking",
          "toilet",
          "prayer_room",
          "restaurant",
          "cafe",
          "buffet",
          "souvenir_shop",
          "accommodation_nearby",
          "atm",
          "first_aid",
          "drinking_water",
          "wifi",
          "guide_service",
          "ticket_office",
          "rest_area",
          "playground"
        ]
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nature": {
          "$ref": "#/$defs/score"
        },
        "history": {
          "$ref": "#/$defs/score"
        },
        "architecture": {
          "$ref": "#/$defs/score"
        },
        "photography": {
          "$ref": "#/$defs/score"
        },
        "adventure": {
          "$ref": "#/$defs/score"
        },
        "accessibility": {
          "$ref": "#/$defs/score"
        },
        "family": {
          "$ref": "#/$defs/score"
        },
        "overall": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "transportation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roadAccess": {
          "enum": [
            "paved",
            "gravel",
            "offroad",
            "no_road",
            null
          ]
        },
        "publicTransport": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "publicTransportNotes": {
          "type": "string"
        },
        "nearestAirport": {
          "$ref": "#/$defs/transportNode"
        },
        "nearestRailwayStation": {
          "$ref": "#/$defs/transportNode"
        },
        "nearestBusTerminal": {
          "$ref": "#/$defs/transportNode"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "climate": {
      "type": "object",
      "description": "فقط داده‌ی اقلیمی؛ bestMonths در visit است",
      "additionalProperties": false,
      "properties": {
        "avoidMonths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        },
        "rainSensitive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "snowAccessible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "summerAvgTempC": {
          "type": [
            "number",
            "null"
          ]
        },
        "winterAvgTempC": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mobileCoverage": {
          "enum": [
            "full",
            "partial",
            "none",
            null
          ]
        },
        "emergencyNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "culturalNotes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dressCode": {
          "$ref": "#/$defs/faText"
        },
        "etiquette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/faText"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thumbnail": {
          "$ref": "#/$defs/mediaItem"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaItem"
          },
          "description": "از ۰ تا حداکثر ۲۰ لینک مستقیم تصویر مرتبط و غیرتکراری. حداقل برای status=active بر اساس نوع Entity است: روستا/مکان/کمپینگ ۳، شهر/شهرستان ۵، استان ۱۰. تصاویر وب (جستجوی تصویر گوگل/بینگ، سایت‌های گردشگری و خبری) با کردیت و sourceUrl معتبر و لایسنس all-rights-reserved پذیرفته می‌شود؛ لایسنس آزاد الزامی نیست.",
          "minItems": 0,
          "maxItems": 20
        },
        "videos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaItem"
          }
        },
        "panoramas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaItem"
          }
        },
        "audios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaItem"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "description": "جایگزین واحد برای nearbyPlaces / recommendedNextPlaces / nearbyVillages / nearbyCities / parentId / children",
      "items": {
        "type": "object",
        "required": [
          "placeId",
          "relationType"
        ],
        "additionalProperties": false,
        "properties": {
          "placeId": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "denormalized برای نمایش سریع"
          },
          "relationType": {
            "enum": [
              "parent",
              "child",
              "nearby",
              "recommended_next",
              "same_route",
              "alternative",
              "gateway_city"
            ]
          },
          "distanceKm": {
            "type": [
              "number",
              "null"
            ]
          },
          "travelTimeMinutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/faText"
          },
          "months": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "description": {
            "$ref": "#/$defs/faText"
          }
        }
      }
    },
    "localFoods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "souvenirs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "description": "دسته‌بندی خطر (مثلاً جاده، کمپ، حیوانات)"
          },
          "text": {
            "type": "string",
            "description": "متن هشدار"
          }
        }
      },
      "description": "هشدارهای دسته‌بندی‌شده برای وسیله سفر، کمپ، حیوانات و عمومی"
    },
    "typeSpecific": {
      "type": "object",
      "description": "فیلدهای مخصوص هر type؛ فقط بلاک مرتبط با type پر می‌شود",
      "additionalProperties": false,
      "properties": {
        "village": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isTourismVillage": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "traditionalArchitecture": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "localLanguage": {
              "type": "string"
            },
            "mainJobs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "famousFor": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "population": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "censusYear": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "natural": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protectedArea": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "protectionLevel": {
              "type": "string"
            },
            "flora": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fauna": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "religious": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "religion": {
              "type": "string"
            },
            "activeWorship": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "nonBelieversAllowed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "type",
          "accessedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
